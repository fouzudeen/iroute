{
  "version": "1.2.0",
  "createdAt": "2026-10-10T09:32:51.857Z",
  "description": "",
  "rules": [
    {
      "id": "high-value-eu-cards",
      "priority": 100,
      "description": "Route high-value EU card transactions to premium PSPs",
      "condition": {
        "operator": "and",
        "conditions": [
          {
            "operator": "gte",
            "field": "amount",
            "value": 500
          },
          {
            "operator": "in",
            "field": "country",
            "value": [
              "DE",
              "FR",
              "NL",
              "BE",
              "AT"
            ]
          },
          {
            "operator": "in",
            "field": "cardBrand",
            "value": [
              "visa",
              "mastercard"
            ]
          }
        ]
      },
      "actions": {
        "providers": [
          {
            "id": "psp-premium-eu",
            "type": "psp",
            "weight": 100,
            "slaMs": 800
          },
          {
            "id": "pgsp-eu-backup",
            "type": "pgsp",
            "weight": 80,
            "slaMs": 1200
          }
        ],
        "fallback": {
          "id": "psp-global",
          "type": "psp",
          "weight": 50
        }
      }
    },
    {
      "id": "risky-customers",
      "priority": 90,
      "description": "Send risky customers to specialized risk PSP",
      "condition": {
        "operator": "gte",
        "field": "customer.riskScore",
        "value": 70
      },
      "actions": {
        "providers": [
          {
            "id": "psp-risk",
            "type": "psp",
            "weight": 100
          }
        ]
      }
    },
    {
      "id": "default",
      "priority": 0,
      "description": "Default route",
      "condition": {
        "operator": "eq",
        "field": "currency",
        "value": "EUR"
      },
      "actions": {
        "providers": [
          {
            "id": "psp-standard",
            "type": "psp",
            "weight": 100
          }
        ]
      }
    }
  ],
  "checksum": "5747f34fe0de6effbd0dcf48b5a46c9429a473a2b2a828d45b8b4b1b8acb554d"
}
{
  "name": "payment-routing-engine",
  "version": "0.1.0",
  "description": "Payment gateway routing engine with versioned decision trees",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec tests/**/*.test.js",
    "test:tap": "node --test --test-reporter=tap tests/**/*.test.js",
    "test:ci": "mkdir -p reports && node --test --test-reporter=tap --test-reporter-destination=reports/test-results.tap tests/**/*.test.js",
    "test:report": "npm run test:ci && node scripts/test-report.js reports/test-results.tap",
    "lint": "eslint src tests scripts",
    "package:rules": "node scripts/package-rules.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.0.0",
    "pino": "^9.5.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "pino-pretty": "^11.3.0"
  },
  "keywords": [
    "payments",
    "routing",
    "psp",
    "pgsp",
    "decision-tree"
  ],
  "license": "MIT"
}